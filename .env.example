# =============================================================================
# Platformă Psihologi — variabile de mediu
# Copiază acest fișier în `.env.local` și completează valorile.
# NU include niciodată chei secrete în Git sau în bundle-ul client.
# =============================================================================

# --- Supabase (obligatoriu) -------------------------------------------------
# Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://proiectul-tau.supabase.co
# Cheia publică (anon/publishable). Este sigură în browser DOAR împreună cu RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...cheie-publica
# Cheia de serviciu. STRICT pe server. Nu o prefixa cu NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...cheie-secreta

# --- Aplicație --------------------------------------------------------------
# URL-ul public al aplicației, folosit la linkurile din e-mailuri și la redirectări.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Numele afișat al platformei (identitatea finală se stabilește ulterior).
NEXT_PUBLIC_PLATFORM_NAME=Platformă Psihologi

# Adresa de contact afișată public (trebuie să fie reală înainte de lansare).
NEXT_PUBLIC_CONTACT_EMAIL=contact@exemplu.ro

# --- Google Search Console (opțional, recomandat) ---------------------------
# Valoarea `content` din metatag-ul HTML de verificare oferit de Search Console.
# Se poate seta și ca variabilă de mediu în Vercel, fără modificări de cod.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- E-mail tranzacțional (opțional) ---------------------------------------
# Furnizor: Resend (https://resend.com). Dacă lipsește, aplicația afișează
# explicit „e-mail neconfigurat” și NU simulează trimiterea.
RESEND_API_KEY=
EMAIL_FROM=Platformă Psihologi <notificari@exemplu.ro>
# Adresa către care ajung mesajele din formularul public de contact.
CONTACT_INBOX_EMAIL=

# --- Protecții și operare ---------------------------------------------------
# Zona orară implicită a platformei.
PLATFORM_TIMEZONE=Europe/Bucharest
# Limita de vârstă minimă acceptată la înregistrare (ani).
NEXT_PUBLIC_MIN_AGE=16

# --- Teste de bază de date (doar local) -------------------------------------
# Folosit de `npm run test:db`. Nu este necesar în producție.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/postgres
